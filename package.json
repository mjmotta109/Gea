{
  "name": "gea-tactics-engine",
  "version": "0.1.0",
  "description": "Motor táctico por turnos estilo Final Fantasy Tactics Advance con temática Zoids",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:update": "UPDATE_GOLDEN=1 vitest run tests/golden.test.ts",
    "demo": "tsx src/demo/cli.ts",
    "demo:auto": "tsx src/demo/cli.ts --auto",
    "web": "node scripts/build-web.mjs",
    "balance": "tsx scripts/balance.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.61.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
